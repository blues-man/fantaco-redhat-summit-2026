# FantaCo Environment Variables
# Copy to .env and fill in actual values

# OpenAI — used by fantaco-product-main/tools/generate_images.py
OPENAI_API_KEY=CHANGE_ME

# LLM Provider — determines which model backend OpenClaw uses
# Options: gcp (Vertex AI), litellm (OpenAI-compatible proxy), anthropic, openai
LLM_PROVIDER=gcp

# LLM (OpenAI-compatible) — used by sales-policy-search and hr-policy-search RAG services
LLM_API_KEY=CHANGE_ME
LLM_API_BASE_URL=https://litellm-prod.apps.maas.redhatworkshops.io
LLM_MODEL_NAME=qwen3-14b

# Embedding model for OpenClaw memory search (agents.defaults.memorySearch).
# Served on the same key and base URL as LLM_MODEL_NAME, so no extra credential.
# Leave empty to skip the memorySearch patch entirely; if it is empty OpenClaw
# falls back to the openai provider default (text-embedding-3-small), which a
# scoped MaaS key will reject with "openai embeddings failed: 401" every turn.
LLM_EMBEDDING_MODEL=nomic-embed-text-v1-5

# Comma-separated fallback chain for the agent. Empty = no fallbacks. The
# operator otherwise seeds hosted OpenAI models that a scoped key 401s on,
# costing ~3s per turn and burying the real error under six auth failures.
LLM_FALLBACK_MODELS=

# Anthropic — optional, used by OpenClaw gateway
ANTHROPIC_API_KEY=CHANGE_ME

# Telegram — used by OpenClaw gateway
TELEGRAM_BOT_TOKEN=CHANGE_ME
# Telegram user ID — restricts bot access to your account only
# Find yours by messaging @userinfobot on Telegram
TELEGRAM_USER_ID=CHANGE_ME

# GCP Vertex AI — used when LLM_PROVIDER=gcp
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
GOOGLE_CLOUD_PROJECT=CHANGE_ME
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-2.5-pro

# OpenShift cluster
OPENSHIFT_CONSOLE_URL=https://console-openshift-console.apps.YOUR_CLUSTER.opentlc.com/

# Student Password
STUDENT_OPENCLAW_PASSWORD=CHANGE_ME
STUDENT_OPENSHIFT_PASSWORD=CHANGE_ME

# Admin User & Password
ADMIN_USER=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME

# OpenClaw model server API key
MODEL_API_KEY=CHANGE_ME

# Langfuse — keys auto-loaded from .state/<cluster-guid>/langfuse.env
# (generated by deploy-traces-langfuse.sh, no manual config needed)
